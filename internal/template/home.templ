package template

// HomeBody renders the hero search form for the landing page.
templ HomeBody() {
	<div class="flex flex-col items-center justify-center min-h-[60vh] gap-6">
		<h1 class="text-5xl font-bold text-center">Find any lyrics</h1>
		<p class="text-gray-400 text-lg text-center">Search millions of tracks from lrclib.net</p>
		<div class="w-full max-w-xl relative">
			<input
				type="search"
				name="q"
				placeholder="Search by track name or artist..."
				autofocus
				class="w-full bg-white/10 border border-white/20 rounded-xl px-5 py-3 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 text-lg"
				hx-get="/search"
				hx-target="#results"
				hx-trigger="input delay:300ms, search"
				hx-indicator="#spinner"
			/>
			<span id="spinner" data-htmx-indicator class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400">
				⟳
			</span>
		</div>
		<div id="results" class="w-full max-w-xl"></div>
	</div>
}

// Home renders the full home page wrapped in the site layout.
templ Home() {
	@Layout("Search", HomeBody())
}
