package template

// ErrorBlock renders an error message with a warning icon.
templ ErrorBlock(msg string) {
	<div class="flex flex-col items-center justify-center py-16 gap-3 text-center">
		<span class="text-4xl">⚠️</span>
		<p class="text-gray-400">{ msg }</p>
	</div>
}

// EmptyState renders a "no content" placeholder with a music note icon.
templ EmptyState(msg string) {
	<div class="flex flex-col items-center justify-center py-16 gap-3 text-center">
		<span class="text-4xl">🎵</span>
		<p class="text-gray-400">{ msg }</p>
	</div>
}
